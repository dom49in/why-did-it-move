# Copy to .env and fill in. Never commit .env. Secrets below are intentionally blank.

# The default is the real mode: Zetaris + Nightshift, both required.
# true  = offline testing only: query data/sample/sales_facts.csv instead of Zetaris, and (only if no Nightshift
#         credentials are set) use the deterministic offline rules instead of a model.
#         Outputs are labelled sample_data / offline-rules.
SAMPLE_MODE=false

# --- Zetaris (data layer) ---------------------------------------------------------------------------
# From inside Docker use host.docker.internal instead of localhost
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Table or view holding the sales facts; see data/schema.json for the columns it must expose
ZETARIS_TABLE=sales.sales_facts
# ZETARIS_ROW_LIMIT=1000
# Second data source: a public web API registered in Zetaris as a REST table (scripts/zetaris_register_fx_rates.sql).
# If unset, the external-context step is skipped and the response says so.
ZETARIS_FX_TABLE=sales.fx_rates_table

# --- Meterless Nightshift (primary AI provider) -----------------------------------------------------
# The app holds ONLY the Nightshift Runtime token. The NVIDIA key goes into Nightshift's Providers tab, never here.
# From inside Docker use http://host.docker.internal:8088/v1
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP=why-did-it-move

# --- Runtime ----------------------------------------------------------------------------------------
PORT=8000
LLM_TIMEOUT=300
MEMORY_DIR=.memory
# LOG_DIR=logs
# LOG_STDOUT=true        # JSONL trace lines are also printed to stdout; set false to silence
# MEMORY_ENABLED=true    # H-MEM on/off
# HMEM_THRESHOLD=0.25    # spec default is 0.35; see README "Deviations"
